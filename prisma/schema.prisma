// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  RECRUITER
}

enum CollectionView {
  PRIVATE
  PUBLIC
}

enum PostCategories {
  ABSTRACT
  ANATOMY
  ANIME
  ANIMALS_WILDLIFE
  ARCHITECTURAL_CONCEPTS
  AUGMENTED_REALITY
  BOOK_ILLUSTRATION
  BOTANICAL_ART
  CALLIGRAPHY
  CHARACTER_ANIMATION
  CHARACTER_DESIGN
  COLLAGE
  COMIC_ART
  CONCEPT_ART
  COSPLAY
  COSTUME_DESIGN
  COVER_ART
  CERAMICS
  CREATURES
  EMBROIDERY
  ENVIRONMENTAL_CONCEPT_ART
  ENVIRONMENTAL_CONCEPT_DESIGN
  FAN_ART
  FANTASY
  FASHION
  FIGURE
  FOOD
  GAME_ART
  GAMEPLAY_DESIGN
  GAMES_ENVIRONMENT
  GRAFFITI
  GRAPHIC_DESIGN
  HANDICRAFT
  HAIR_STYLING
  HORROR
  ILLUSTRATION
  INDUSTRIAL_DESIGN
  JEWELRY
  KNITTING
  LEGO
  LANDSCAPE
  LEVEL_DESIGN
  LIGHTING
  MAKEUP
  MANGA
  MECHANICAL_DESIGN
  MEDICAL
  MECHA
  MINIATURE_ART
  MOTION_GRAPHICS
}

enum PostMedium {
  DIGITAL
  OIL_PAINT
  WATERCOLOR
  PHOTOGRAPHY
  SCULPTURE
  MIXED_MEDIA
  SKETCH
  PASTELS
  INK
  COLORED_PENCIL
  THREE_D
  CRAYON
  ALCOHOL_MARKERS
  ACRYLIC
  TWO_D
  VFX
  ANIMATION
  TRADITIONAL_ART
  OTHER
}

model User {
  id            String       @id
  role          Role         @default(USER)
  name          String?
  username      String?      @unique
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?      @default("https://res.cloudinary.com/dailhnvvl/image/upload/v1771605999/pfpdefault_omrkpw.png")
  bio           String?
  portfolio     String?
  location      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  followers     Follow[]     @relation("followers")
  following     Follow[]     @relation("following")
  artPosts      Post[]
  collections   Collection[]
  likes         Like[]
  comments      Comment[]
  savedPosts    Save[]

  @@index([email])
  @@index([username])
  @@index([name])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Follow {
  followerId  String
  followingId String

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follow")
}

model Post {
  id             String       @id @default(uuid())
  authorId       String
  user           User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title          String
  thumbnail      String
  artImages      PostImages[]
  tags           String[]
  inPortfolio    Boolean      @default(false)
  mediums        PostMedium[]
  description    String?
  likes          Like[]
  Collections    Collection[]
  comments       Comment[]
  scoreUpdatedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
  savedBy        Save[]

  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("post")
}

model PostImages {
  id            String   @id @default(uuid())
  postId        String
  url           String
  isAIGenerated Boolean  @default(false)
  artPost       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  order         Int
  createdAt     DateTime @default(now())

  @@unique([postId, order])
  @@index([postId])
  @@map("post_images")
}

model Save {
  userId String
  postId String

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("save")
}

model Collection {
  id      String         @id @default(uuid())
  name    String
  ownerId String
  view    CollectionView @default(PUBLIC)
  user    User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  posts   Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([ownerId])
  @@map("collection")
}

model Like {
  artPostId String
  ownerId   String
  artPost   Post     @relation(fields: [artPostId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([artPostId, ownerId])
  @@index([artPostId])
  @@index([ownerId])
  @@map("like")
}

model Comment {
  id        String    @id @default(uuid())
  artPostId String
  ownerId   String
  content   String
  likes     Int       @default(0)
  replies   Comment[] @relation("replies")
  artPost   Post      @relation(fields: [artPostId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  comment   Comment?  @relation("replies", fields: [commentId], references: [id])
  commentId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())

  @@index([artPostId, ownerId])
  @@index([artPostId])
  @@index([artPostId, createdAt(sort: Desc)])
  @@map("comment")
}
